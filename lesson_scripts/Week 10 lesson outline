# 3. Dynamic Tail & Physics (make_tail) - Generates an 8-joint tail that mathematically tapers the size of the controls down the chain
denSR.den_makeTailPivs(prefix='', name='Tail', jointCount=8, radius=1.0, dpTime=0.01, size=100)
denSR.den_makeTailRig(prefix='', name='Tail', jointCount=8, radius=0.7, ctrlRadius=2.0, controlJoints=(1,5,8), secondaryAxisOrient='yup', dpTime=0.01 )  # IK/FK Tail Rig
denSR.den_makeTailRigIK(prefix='', name='Tail', jointCount=8, radius=0.7, ctrlRadius=2.0, controlJoints=(1,5,8), secondaryAxisOrient='yup', dpTime=0.01)  # IK Only
denSR.den_makeTailRigFK(prefix='', name='Tail', jointCount=8, radius=0.7, ctrlRadius=2.0, secondaryAxisOrient='yup', dpTime=0.01)  # FK Only

# Nucleus dynamics: tool can attach a Maya Hair System (Nucleus) to genrate procedural jiggle
denSR.den_addTailDynamics(prefix='', name='Tail', TailRigGrp='TailRig_Grp', TailSpaceIN='TailPelvisSpace_IN', TailHandles=[], TailBindJnts=[], nucleusScale=1.0, dpTime=0.01)
denSR.den_addTailDynamics(prefix='', name='Tail', TailRigGrp='TailRig_Grp', TailSpaceIN='TailPelvisSpace_IN', TailHandles=['Tail01_JntIkh', 'Tail02_JntIkh', 'Tail03_JntIkh', 'Tail04_JntIkh', 'Tail05_JntIkh', 'Tail06_JntIkh', 'Tail07_JntIkh', 'Tail08_JntIkh'], TailBindJnts=['Tail01_Jnt', 'Tail02_Jnt', 'Tail03_Jnt', 'Tail04_Jnt', 'Tail05_Jnt', 'Tail06_Jnt', 'Tail07_Jnt', 'Tail08_Jnt'], nucleusScale=1.0, dpTime=0.01)
# TailCrvDynShape - The dynamic shape node created for the tail's Nucleus dynamics, responsible for procedural jiggle effects

